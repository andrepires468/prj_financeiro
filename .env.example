# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.

# URL base usada pelo frontend (Vite) para chamar a API.
# Local: http://localhost:8099
# LAN:   http://<IP-DO-SERVIDOR>:8099
VITE_API_BASE_URL=http://localhost:8099
VITE_API_VERSION=/api/v1

# Banco de dados (opcional)
# DB_PASSWORD=1234
# DB_DATABASE=home
