# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.

# URL base usada pelo frontend (Vite) para chamar a API.
# Local: http://localhost:5082
# LAN:   http://<IP-DO-SERVIDOR>:5082
VITE_API_BASE_URL=http://localhost:5082
VITE_API_VERSION=/api/v1

# Banco de dados (opcional)
# DB_PASSWORD=1234
# DB_DATABASE=home

# Upload de backup para o MEGA (opcional — usado por scripts/backup-db.sh)
# Se MEGA_EMAIL/MEGA_PASSWORD não forem definidos, rode 'mega-login' manualmente uma vez.
# MEGA_EMAIL=seu-email@exemplo.com
# MEGA_PASSWORD=sua-senha
# MEGA_REMOTE_DIR=/Backups/Financeiro
# MEGA_KEEP_DAYS: dias para manter no MEGA. Use 0 para nunca expirar.
# MEGA_KEEP_DAYS=0
